# No API keys are required to rebuild all datasets, run tests, or launch the dashboard.
# All default analytics use public unauthenticated endpoints:
#   - https://api.nearblocks.io/v1/charts & /v1/stats
#   - https://free.rpc.fastnear.com (fallback: https://rpc.mainnet.near.org)
#   - https://api.llama.fi & https://stablecoins.llama.fi
#   - https://1click.chaindefuser.com/v0/tokens & /v0/quote (dry=true)
#   - https://cloud-api.near.ai/v1/models

# Optional: Partner JWT for authenticated NEAR Intents Explorer / 1Click fee tier checks
INTENTS_EXPLORER_JWT=

# Optional: Path to exported Google BigQuery JSON/CSV results if running queries/bigquery/*.sql
BIGQUERY_EXPORT_DIR=
